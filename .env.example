# Port the Express server will run on
PORT=5000

# MongoDB connection string.
# - Local MongoDB (default install):        mongodb://127.0.0.1:27017/merabox
# - MongoDB Atlas (free tier) looks like:    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/merabox
MONGODB_URI=mongodb://127.0.0.1:27017/merabox
